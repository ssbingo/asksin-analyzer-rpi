# OLED-Anzeige (M11) — eigener Dienst, weil die Darstellung mit den
# Bibliotheken des Vorbilds arbeitet (adafruit_ssd1306 + Pillow in einem
# eigenen venv). Der Analyzer-Dienst schreibt nur seine Werte in eine Datei;
# dieser Dienst zeichnet daraus dasselbe Bild wie das Status-LED-OLED-Projekt.
#
# Laeuft unprivilegiert als 'asksin' — der Zugriff auf /dev/i2c-1 kommt ueber
# die Gruppe 'i2c', nicht ueber Root.
[Unit]
Description=AskSin-Analyzer: OLED-Anzeige
After=asksin-analyzer.service
Wants=asksin-analyzer.service
# Diese Grenze gilt AUSSCHLIESSLICH fuer echte Abstuerze des Helfers.
#
# Ein nicht erreichbares Display ist ausdruecklich KEIN Absturz mehr: Seit
# dem 18.08.2026 wartet oled.py selbst darauf, mit wachsendem Abstand. Vorher
# beendete es sich, systemd verbrauchte die fuenf Versuche in 25 Sekunden und
# gab auf — die Anzeige blieb dunkel, bis jemand von Hand nachstartete. Auf
# Analyzer 04 ist das mehrfach passiert (einmal 25 Fehlversuche, einmal 5).
# Wer diese Grenze wieder als "Schutz gegen fehlendes Display" liest, baut
# genau den Fehler zurueck.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
# Legt /run/asksin-analyzer an (tmpfs). Dort liegen die kurzlebigen
# Austauschdateien zwischen den Diensten — Farbe, Anzeigezustand, Framebuffer.
# Preserve, damit das Verzeichnis einen Neustart eines einzelnen Dienstes
# ueberlebt und die anderen nicht ins Leere greifen.
RuntimeDirectory=asksin-analyzer
RuntimeDirectoryPreserve=yes
Type=simple
User=asksin
Group=asksin
SupplementaryGroups=i2c gpio
# lgpio (ueber Blinka) legt seine Benachrichtigungs-Pipes im Arbeitsverzeichnis
# an — genauer in $LG_WD, ersatzweise $HOME, ersatzweise ".". Ohne diese drei
# Zeilen landet es bei "//.lgd-nfy0" und scheitert:
#   xCreatePipe: Can't set permissions (436) for //.lgd-nfy0
#   [Errno 2] No such file or directory: '.lgd-nfy-3'
# ProtectHome=true blendet /home ohnehin aus; das Datenverzeichnis ist der
# richtige Ort und steht schon in ReadWritePaths.
WorkingDirectory=/var/lib/asksin-analyzer
Environment=HOME=/var/lib/asksin-analyzer
Environment=LG_WD=/var/lib/asksin-analyzer
ExecStart=/opt/asksin-analyzer/oled-venv/bin/python /opt/asksin-analyzer/deploy/oled.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/asksin-analyzer
# /run ausdruecklich dazu: RuntimeDirectory= allein hat auf dem
# Geraet nicht gereicht — der Dienst bekam beim Schreiben
# "Read-only file system", weil ProtectSystem=strict /run sperrt.
# Das fuehrende Minus macht die Zeile vertraeglich, solange es das
# Verzeichnis noch nicht gibt.
ReadWritePaths=-/run/asksin-analyzer
# Bewusst KEIN DeviceAllow: Sobald eine solche Zeile dasteht, schaltet systemd
# auf DevicePolicy=closed und sperrt jedes nicht genannte Geraet — damit auch
# die gpiochip-Knoten, ueber die Blinka auf dem Pi 5 arbeitet. Der Zugriff auf
# /dev/i2c-1 kommt ohnehin ueber die Gruppe 'i2c', nicht ueber diese Liste.

[Install]
WantedBy=multi-user.target

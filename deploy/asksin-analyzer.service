# systemd-Unit des AskSin-Analyzer-Core.
# Installation: siehe deploy/README.md
[Unit]
Description=AskSin-Analyzer Core (BidCoS-Funkanalyse)
After=network-online.target
Wants=network-online.target

[Service]
# Legt /run/asksin-analyzer an (tmpfs). Dort liegen die kurzlebigen
# Austauschdateien zwischen den Diensten — Farbe, Anzeigezustand, Framebuffer.
# Preserve, damit das Verzeichnis einen Neustart eines einzelnen Dienstes
# ueberlebt und die anderen nicht ins Leere greifen.
RuntimeDirectory=asksin-analyzer
RuntimeDirectoryPreserve=yes
Type=simple
User=asksin
Group=asksin
# dialout: Zugriff auf die serielle Schnittstelle des Sniffers
SupplementaryGroups=dialout
ExecStart=/usr/bin/node /opt/asksin-analyzer/core/bin/analyzerd.ts /etc/asksin-analyzer/config.json
Restart=always
RestartSec=3

# Ports unter 1024 sind privilegiert. Ohne diese Fähigkeit scheitert der
# Dienst beim Binden auf Port 80 mit „listen EACCES" — und zwar erst nach
# dem vollständigen Hochlauf, was die Fehlersuche unnötig schwer macht.
# CAP_NET_BIND_SERVICE erlaubt genau das eine und sonst nichts; die
# Bounding-Set-Zeile nimmt dem Dienst alle übrigen Fähigkeiten dauerhaft.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Härtung — der Dienst braucht nur sein Datenverzeichnis beschreibbar
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/asksin-analyzer
# /run ausdruecklich dazu: RuntimeDirectory= allein hat auf dem
# Geraet nicht gereicht — der Dienst bekam beim Schreiben
# "Read-only file system", weil ProtectSystem=strict /run sperrt.
# Das fuehrende Minus macht die Zeile vertraeglich, solange es das
# Verzeichnis noch nicht gibt.
ReadWritePaths=-/run/asksin-analyzer
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

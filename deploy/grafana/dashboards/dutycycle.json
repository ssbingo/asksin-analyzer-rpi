{
  "uid": "asksin-dutycycle",
  "title": "AskSin — Duty-Cycle-Wächter",
  "description": "Wer sendet zu viel — und seit wann.",
  "tags": [
    "asksin",
    "AskSin-Analyzer"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "constant",
        "query": "asksin",
        "current": {
          "text": "asksin",
          "value": "asksin"
        },
        "hide": 2
      },
      {
        "name": "standort",
        "label": "Standort",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "asksin-influx"
        },
        "multi": true,
        "includeAll": true,
        "refresh": 1,
        "query": {
          "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"asksin\", tag: \"standort\")"
        },
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Geräte über der Schwelle",
      "description": "Wie viele Geräte gerade über 80 % liegen.",
      "datasource": {
        "type": "influxdb",
        "uid": "asksin-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"analyzer\")\n  |> filter(fn: (r) => r._field == \"dutyAlarme\")\n  |> filter(fn: (r) => r.standort =~ /^(${standort:regex})$/)\n  |> group()\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Höchster Duty-Cycle",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "asksin-influx"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"analyzer\")\n  |> filter(fn: (r) => r._field == \"maxDutyCycle\")\n  |> filter(fn: (r) => r.standort =~ /^(${standort:regex})$/)\n  |> group()\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {

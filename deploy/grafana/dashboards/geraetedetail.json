{
  "uid": "asksin-geraet",
  "title": "AskSin — Gerätedetail",
  "description": "Ein Gerät im Detail, über alle Standorte hinweg.",
  "tags": [
    "asksin",
    "AskSin-Analyzer"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "constant",
        "query": "asksin",
        "current": {
          "text": "asksin",
          "value": "asksin"
        },
        "hide": 2
      },
      {
        "name": "geraet",
        "label": "Gerät",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "asksin-influx"
        },
        "multi": false,
        "includeAll": false,
        "refresh": 1,
        "query": {
          "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"asksin\", tag: \"name\")"
        },
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Zuletzt gehört vor",
      "description": "Kleinster Wert über alle Standorte wäre genauer; hier steht der zuletzt geschriebene.",
      "datasource": {
        "type": "influxdb",
        "uid": "asksin-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"geraet\")\n  |> filter(fn: (r) => r._field == \"sekundenSeitEmpfang\")\n  |> filter(fn: (r) => r.name == \"${geraet}\")\n  |> group()\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 21600
              },
              {
                "color": "red",
                "value": 86400
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Duty-Cycle",
      "description": "",

    {
      "type": "timeseries",
      "title": "Empfangsstärke je Standort",
      "description": "Eine Linie je Analyzer. Damit sieht man sofort, welcher Standort dieses Gerät am besten hört — die Funkloch-Karte als Verlauf.",
      "datasource": {
        "type": "influxdb",
        "uid": "asksin-influx"
